{
  // =====================================================================
  // CONFIGURATION CLOUDFLARE
  // ---------------------------------------------------------------------
  // Cloudflare a deux parcours pour publier un site : « Pages », l'ancien,
  // et « Workers », vers lequel ils poussent désormais tout le monde. Le
  // second est celui qui s'est présenté à l'inscription — il déploie avec
  // « npx wrangler deploy » et lit ce fichier.
  //
  // Le site reste 100 % statique : il n'y a AUCUN code serveur ici, juste
  // un dossier de fichiers à servir. « assets » sans « main », c'est
  // exactement ça — Cloudflare sert le dossier et rien d'autre.
  //
  // Le dossier « site » est produit par construire.sh, la même recette que
  // celle qu'exécute GitHub Actions.
  // =====================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "as-mine",
  "compatibility_date": "2026-09-04",

  // PAS D'ADRESSE D'APERÇU PAR BRANCHE (15 octobre 2026). Par défaut,
  // Cloudflare construit chaque branche poussée et la sert à
  // « <branche>-as-mine.<compte>.workers.dev » — et l'aperçu SURVIT à la
  // suppression de la branche. Barbaros a retrouvé dans Safari, neuf jours
  // après la fusion de la PR #328, un site figé au 6 octobre qui disait
  // encore « une seule solution » et « solutions de mobilité », deux mots
  // retirés depuis. Aucun contrôle ne regarde workers.dev : le monitoring
  // ne lit qu'elatransfer.com. Le seul site qu'on montre est celui de
  // « main », sur le domaine ; une vérification avant fusion se fait en
  // local (construire.sh, puis les suites), jamais sur une adresse publique.
  // Clé vérifiée dans le schéma de wrangler 4.151 (« preview_urls »,
  // booléen). « workers_dev » n'est PAS touché : on ne sait pas d'ici
  // comment le domaine est relié au Worker, et le couper pourrait couper
  // le site.
  "preview_urls": false,

  "assets": {
    "directory": "./site",

    // UNE ADRESSE INCONNUE REND UNE VRAIE 404 (18 octobre 2026).
    // C'était « single-page-application » : toute adresse inconnue rendait
    // index.html EN 200. Mesuré sur wrangler 4.151 : /page-inexistante,
    // /en/…, /ela-admin/…, et même /photos/x.jpg ou /x.js recevaient
    // l'accueil, indexable, canonique « / ». Deux torts : Google voyait une
    // copie de l'accueil par lien mal recopié (« soft 404 »), et un fichier
    // oublié par construire.sh répondait 200 — le contrôle de production,
    // qui guette les réponses ≥ 400, ne pouvait plus le voir.
    // Ce repli ne servait à rien d'autre : le site ne route JAMAIS par le
    // chemin (écrans et espaces passent par des paramètres, ?h=, ?ok=,
    // ?reception=…), chaque espace est un vrai fichier publié.
    // « 404-page » sert le 404.html LE PLUS PROCHE, avec le code 404 :
    // /404.html en français, /en/404.html sous /en/. Le client garde une
    // sortie (réserver, appeler) au lieu d'une page d'erreur nue.
    // Les anciennes adresses connues sont redirigées par _redirects.
    "not_found_handling": "404-page",

    /* « auto-trailing-slash », et surtout PAS « none ».
       Première tentative : « none », pour que « /admin.html » garde son
       extension. Effet de bord non prévu — « none » ne sert QUE les
       chemins exacts, et supprime du même coup la résolution des
       DOSSIERS. « /demos/ » n'était donc plus un dossier dont on sert
       l'index : c'était une adresse inconnue, qui retombait sur la règle
       ci-dessus et affichait le site de réservation à la place de la
       galerie. Barbaros l'a vu tout de suite.
       Pire : la racine « / » ne fonctionnait elle aussi que par accident,
       par ce même repli.
       Avec « auto-trailing-slash », « /demos/ » sert bien
       « /demos/index.html », et « /admin.html » redirige vers « /admin » —
       une redirection, pas une rupture : les liens déjà envoyés aux
       clients continuent de fonctionner, paramètres compris. */
    "html_handling": "auto-trailing-slash"
  }
}
