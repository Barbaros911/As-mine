# ELA Transfer — modèle de configuration serveur
# Ce fichier ne contient AUCUNE valeur réelle.
# Copier ces noms dans le gestionnaire de secrets du serveur.
# Aligné le 17/10/2026 sur les noms que les fonctions lisent réellement
# (Deno.env.get dans supabase/functions/). Rôle de chacun : COMPTES.md, § 3.

# Supabase — posés par Supabase lui-même dans les fonctions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alertes et notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
VAPID_PUBLIQUE=
VAPID_PRIVEE=
VAPID_SUJET=

# Code de chaque réception d'hôtel : un secret par hôtel, HOTEL_<CLÉ>_CODE
HOTEL_EASYHOTEL_AEROVILLE_CODE=

# Facultatifs
RESEND_CLE=
EMAIL_EXPEDITEUR=
EMAIL_DESTINATAIRE=
ADRESSE_ADMIN=
DEMO_SESSION_SECRET=
TURNSTILE_SECRET=

# Paiement — code Stripe de TEST seulement, aucune page ne l'appelle
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Les clés d'itinéraire ne sont PAS des secrets serveur : elles partent dans
# la page (CLE_ORS, CLE_MAPBOX dans index.html), aucune fonction ne les lit.
