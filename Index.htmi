const WHATSAPP_NUMBER = "33XXXXXXXXX"; // <-- Numéro WhatsApp de la flotte As-mine (format international sans +)

/* =====================================================================
   I18N — 10 LANGUES
   ===================================================================== */
const I18N = {
fr:{drivers_available:"Chauffeurs disponibles",tagline:"Chauffeur privé — Paris & Île-de-France",hero_title:"L'excellence, à chaque trajet.",hero_sub:"Réservez un chauffeur professionnel en moins de deux minutes. Prix fixe, ponctualité garantie, confirmation instantanée.",tab_simple:"Trajet Simple",tab_disposal:"Mise à Disposition",label_pickup:"Adresse de départ",label_dropoff:"Adresse d'arrivée",label_date:"Date",label_time:"Heure",label_pickup_disp:"Lieu de prise en charge",label_duration:"Durée de mise à disposition",btn_search:"Voir les tarifs",airports_eyebrow:"Forfaits fixes",airports_title:"Aéroports Paris & Beauvais",airports_sub:"CDG · Orly · Beauvais — prix bloqué, zéro surprise.",label_address_complement:"Votre adresse à Paris / IDF",dir_to_airport:"Paris → Aéroport",dir_from_airport:"Aéroport → Paris",airport_cdg:"Roissy - Charles de Gaulle",airport_orly:"Paris - Orly",airport_beauvais:"Beauvais - Tillé",veh_eco:"Berline Éco",veh_premium:"Berline Premium",veh_van_eco:"Van Éco",veh_van_premium:"Van Premium",vehicles_title:"Choisissez votre véhicule",vehicles_sub_simple:"Trajet estimé à",vehicles_sub_disposal:"Mise à disposition —",btn_continue:"Continuer",price_from:"à partir de",night_surcharge_note:"Majoration nuit/week-end de +20% appliquée automatiquement et affichée en toute transparence.",back:"Retour",summary_title:"Récapitulatif",trip_type_simple:"Trajet simple",trip_type_disposal:"Mise à disposition",trip_type_airport:"Forfait aéroport",client_info:"Vos informations",full_name:"Nom complet",phone_number:"Téléphone (avec indicatif)",payment_title:"Paiement",pay_card:"Carte Bancaire",pay_paypal:"PayPal",card_number:"Numéro de carte",card_expiry:"MM/AA",card_cvc:"CVC",card_name:"Nom sur la carte",btn_confirm_pay:"Confirmer et Payer",processing:"Traitement du paiement…",confirmation_title:"Réservation confirmée",confirmation_sub:"Votre chauffeur As-mine vous attend. Le récapitulatif a été envoyé sur WhatsApp.",confirmation_ref:"Référence",btn_new_booking:"Nouvelle réservation",faq_title:"Questions fréquentes",faq_q1:"Puis-je transporter des bagages volumineux ?",faq_a1:"Oui, précisez-le lors de la réservation : nos berlines acceptent 2 valises cabine + 2 bagages, nos vans jusqu'à 6 grandes valises.",faq_q2:"Le chauffeur m'attend-il avec une pancarte ?",faq_a2:"Systématiquement pour les prises en charge en aéroport ou en gare, avec votre nom inscrit lisiblement.",faq_q3:"Puis-je annuler sans frais ?",faq_a3:"Toute annulation effectuée plus de 60 minutes avant l'heure prévue est intégralement remboursée, sans aucun frais.",cookie_text:"Nous utilisons des cookies pour améliorer votre expérience de réservation. Conforme RGPD.",cookie_accept:"Accepter",cookie_reject:"Refuser",install_app:"Installer l'application",install_toast:"Application ajoutée à l'écran d'accueil.",distance_label:"Distance estimée",duration_label_h:"h",select_placeholder:"Tapez une adresse…",no_results:"Aucune adresse trouvée",nav_home:"Accueil",nav_airports:"Aéroports",nav_faq:"Aide",wa_ref:"Réf",wa_status:"Statut",wa_paid:"PAYÉ",wa_client:"Client",wa_phone:"Téléphone",wa_trip:"Trajet",wa_vehicle:"Véhicule",wa_total:"Prix total TTC",wa_thanks:"Merci de votre confiance. Votre chauffeur vous contactera avant la prise en charge.",wa_from:"Départ",wa_to:"Arrivée",wa_date:"Date",wa_time:"Heure",wa_duration:"Durée",field_required:"Merci de renseigner tous les champs requis.",
label_promo:"Code promo (optionnel)",extra_pets:"🐾 Animal (+5€)",extra_child_seat:"🧸 Siège enfant (+5€)",vat_note:"Prix TTC, TVA 10% incluse (transport de personnes).",edit_trip:"Modifier",promo_title:"Code promo",promo_apply:"Appliquer",promo_valid:"Code appliqué avec succès.",promo_invalid:"Code promo invalide ou expiré.",step_trip:"Trajet",step_vehicle:"Véhicule",step_payment:"Paiement",legal_title:"Informations légales",legal_cgv:"Conditions Générales de Vente",legal_mentions:"Mentions légales",legal_privacy:"Politique de confidentialité",nav_history:"Trajets",history_title:"Mes trajets",history_note:"Historique de cette session uniquement — non conservé après fermeture.",history_empty:"Aucun trajet pour l'instant.",cookie_essential:"Essentiels",cookie_essential_desc:"Nécessaires au fonctionnement du site. Toujours actifs.",cookie_analytics:"Statistiques",cookie_analytics_desc:"Nous aident à comprendre l'usage du site.",cookie_marketing:"Marketing",cookie_marketing_desc:"Utilisés pour des offres personnalisées.",cookie_customize:"Personnaliser",cookie_save:"Enregistrer mes choix",error_future_time:"Merci de choisir une date et une heure dans le futur.",error_route:"Impossible de calculer l'itinéraire, merci de vérifier les adresses.",wa_extras:"Options",wa_promo:"Code promo",wa_ht:"Prix HT",wa_vat:"TVA (10%)",
legal_cgv_body:"CONDITIONS GÉNÉRALES DE VENTE — AS-MINE CHAUFFEURS\n\n1. Objet\nLes présentes conditions régissent la réservation et l'exécution de prestations de transport de personnes avec chauffeur (VTC) proposées par As-mine.\n\n2. Réservation et prix\nLe prix affiché lors de la réservation est ferme et définitif pour les forfaits aéroports. Pour les trajets simples et les mises à disposition, le prix est calculé automatiquement selon la distance, la durée et d'éventuelles majorations nuit/week-end, affichées avant paiement.\n\n3. Annulation\nToute annulation effectuée plus de 60 minutes avant l'heure de prise en charge prévue est intégralement remboursée. Passé ce délai, des frais peuvent s'appliquer.\n\n4. Paiement\nLe paiement s'effectue en ligne par carte bancaire ou PayPal au moment de la confirmation de la réservation.\n\n5. Responsabilité\nAs-mine s'engage à fournir un service ponctuel et professionnel. La société décline toute responsabilité en cas de force majeure (conditions météorologiques, embouteillages exceptionnels, grèves).\n\n6. Litiges\nLes présentes conditions sont soumises au droit français. Tout litige relève de la compétence des tribunaux français.\n\n[Document type à faire valider par un professionnel du droit avant mise en production.]",
legal_mentions_body:"MENTIONS LÉGALES\n\nÉditeur du site\nAs-mine Chauffeurs\nForme juridique : [À compléter]\nSIRET : [À compléter]\nLicence VTC n° : [À compléter — obligatoire pour l'exercice de l'activité VTC en France]\nSiège social : [Adresse à compléter]\nDirecteur de la publication : [À compléter]\n\nHébergement\n[Nom et adresse de l'hébergeur à compléter]\n\nContact\nWhatsApp : voir bouton de réservation\nEmail : [À compléter]\n\n[Ces informations doivent être complétées avec les données réelles de la société avant toute mise en ligne, conformément à la loi pour la confiance dans l'économie numérique (LCEN).]",
legal_privacy_body:"POLITIQUE DE CONFIDENTIALITÉ\n\n1. Données collectées\nNom, téléphone, adresses de départ et d'arrivée, informations de paiement (traitées par un prestataire tiers sécurisé, jamais stockées par As-mine).\n\n2. Finalité\nCes données sont utilisées exclusivement pour organiser et exécuter votre course, et vous contacter avant la prise en charge.\n\n3. Conservation\nLes données de réservation sont conservées le temps nécessaire à la prestation et aux obligations légales (comptabilité), puis supprimées.\n\n4. Droits RGPD\nConformément au RGPD, vous disposez d'un droit d'accès, de rectification, d'effacement et de portabilité de vos données. Pour exercer ces droits, contactez-nous via WhatsApp ou par email.\n\n5. Cookies\nDes cookies essentiels sont utilisés pour le fonctionnement du site. Des cookies statistiques et marketing ne sont déposés qu'avec votre consentement explicite, modifiable à tout moment.\n\n[Document type à faire valider par un professionnel du droit avant mise en production.]"},
en:{drivers_available:"Drivers available",tagline:"Private chauffeur — Paris & Greater Paris",hero_title:"Excellence, on every ride.",hero_sub:"Book a professional chauffeur in under two minutes. Fixed price, guaranteed punctuality, instant confirmation.",tab_simple:"Single Trip",tab_disposal:"Hourly Hire",label_pickup:"Pickup address",label_dropoff:"Drop-off address",label_date:"Date",label_time:"Time",label_pickup_disp:"Pickup location",label_duration:"Hire duration",btn_search:"See fares",airports_eyebrow:"Fixed packages",airports_title:"Paris & Beauvais Airports",airports_sub:"CDG · Orly · Beauvais — locked price, zero surprise.",label_address_complement:"Your address in Paris / IDF",dir_to_airport:"Paris → Airport",dir_from_airport:"Airport → Paris",airport_cdg:"Roissy - Charles de Gaulle",airport_orly:"Paris - Orly",airport_beauvais:"Beauvais - Tillé",veh_eco:"Eco Sedan",veh_premium:"Premium Sedan",veh_van_eco:"Eco Van",veh_van_premium:"Premium Van",vehicles_title:"Choose your vehicle",vehicles_sub_simple:"Estimated trip of",vehicles_sub_disposal:"Hourly hire —",btn_continue:"Continue",price_from:"from",night_surcharge_note:"A +20% night/weekend surcharge is applied automatically and shown transparently.",back:"Back",summary_title:"Summary",trip_type_simple:"Single trip",trip_type_disposal:"Hourly hire",trip_type_airport:"Airport package",client_info:"Your details",full_name:"Full name",phone_number:"Phone (with country code)",payment_title:"Payment",pay_card:"Credit Card",pay_paypal:"PayPal",card_number:"Card number",card_expiry:"MM/YY",card_cvc:"CVC",card_name:"Name on card",btn_confirm_pay:"Confirm and Pay",processing:"Processing payment…",confirmation_title:"Booking confirmed",confirmation_sub:"Your As-mine chauffeur is expecting you. The summary was sent on WhatsApp.",confirmation_ref:"Reference",btn_new_booking:"New booking",faq_title:"Frequently asked questions",faq_q1:"Can I bring large luggage?",faq_a1:"Yes, just mention it when booking: sedans take 2 cabin bags + 2 suitcases, vans up to 6 large suitcases.",faq_q2:"Will the driver hold a name sign?",faq_a2:"Always for airport and station pickups, with your name clearly displayed.",faq_q3:"Can I cancel for free?",faq_a3:"Any cancellation made more than 60 minutes before the scheduled time is fully refunded, at no cost.",cookie_text:"We use cookies to improve your booking experience. GDPR compliant.",cookie_accept:"Accept",cookie_reject:"Reject",install_app:"Install the app",install_toast:"App added to your home screen.",distance_label:"Estimated distance",duration_label_h:"h",select_placeholder:"Type an address…",no_results:"No address found",nav_home:"Home",nav_airports:"Airports",nav_faq:"Help",wa_ref:"Ref",wa_status:"Status",wa_paid:"PAID",wa_client:"Client",wa_phone:"Phone",wa_trip:"Trip",wa_vehicle:"Vehicle",wa_total:"Total price",wa_thanks:"Thank you for your trust. Your driver will contact you before pickup.",wa_from:"From",wa_to:"To",wa_date:"Date",wa_time:"Time",wa_duration:"Duration",field_required:"Please fill in all required fields.",
label_promo:"Promo code (optional)",extra_pets:"🐾 Pet (+€5)",extra_child_seat:"🧸 Child seat (+€5)",vat_note:"Price incl. VAT, 10% included (passenger transport).",edit_trip:"Edit",promo_title:"Promo code",promo_apply:"Apply",promo_valid:"Code applied successfully.",promo_invalid:"Invalid or expired promo code.",step_trip:"Trip",step_vehicle:"Vehicle",step_payment:"Payment",legal_title:"Legal information",legal_cgv:"Terms and Conditions",legal_mentions:"Legal notice",legal_privacy:"Privacy policy",nav_history:"Trips",history_title:"My trips",history_note:"This session's history only — not kept after closing.",history_empty:"No trips yet.",cookie_essential:"Essential",cookie_essential_desc:"Required for the site to work. Always active.",cookie_analytics:"Analytics",cookie_analytics_desc:"Help us understand how the site is used.",cookie_marketing:"Marketing",cookie_marketing_desc:"Used for personalised offers.",cookie_customize:"Customise",cookie_save:"Save my choices",error_future_time:"Please choose a date and time in the future.",error_route:"Unable to calculate the route, please check the addresses.",wa_extras:"Options",wa_promo:"Promo code",wa_ht:"Price excl. VAT",wa_vat:"VAT (10%)",
legal_cgv_body:"TERMS AND CONDITIONS — AS-MINE CHAUFFEURS\n\n1. Purpose\nThese terms govern the booking and delivery of chauffeur-driven passenger transport services (VTC) offered by As-mine.\n\n2. Booking and pricing\nThe price shown at booking is fixed and final for airport packages. For single trips and hourly hire, the price is calculated automatically based on distance, duration and any night/weekend surcharge, shown before payment.\n\n3. Cancellation\nAny cancellation made more than 60 minutes before the scheduled pickup time is fully refunded. After this window, fees may apply.\n\n4. Payment\nPayment is made online by credit card or PayPal when the booking is confirmed.\n\n5. Liability\nAs-mine is committed to providing a punctual, professional service. The company declines liability in cases of force majeure (weather, exceptional traffic, strikes).\n\n6. Disputes\nThese terms are governed by French law. Any dispute falls under the jurisdiction of French courts.\n\n[Template document — to be validated by a legal professional before production use.]",
legal_mentions_body:"LEGAL NOTICE\n\nPublisher\nAs-mine Chauffeurs\nLegal form: [To be completed]\nCompany registration number: [To be completed]\nVTC licence no.: [To be completed — mandatory to operate as a private hire driver in France]\nRegistered office: [Address to be completed]\nPublication director: [To be completed]\n\nHosting\n[Host name and address to be completed]\n\nContact\nWhatsApp: see booking button\nEmail: [To be completed]\n\n[This information must be completed with the company's real details before going live.]",
legal_privacy_body:"PRIVACY POLICY\n\n1. Data collected\nName, phone number, pickup and drop-off addresses, payment information (processed by a secure third-party provider, never stored by As-mine).\n\n2. Purpose\nThis data is used solely to organise and carry out your ride, and to contact you before pickup.\n\n3. Retention\nBooking data is kept for as long as necessary to deliver the service and meet legal obligations (accounting), then deleted.\n\n4. Your rights\nUnder GDPR, you have the right to access, rectify, erase and port your data. To exercise these rights, contact us via WhatsApp or email.\n\n5. Cookies\nEssential cookies are used for the site to function. Analytics and marketing cookies are only set with your explicit consent, which you can change at any time.\n\n[Template document — to be validated by a legal professional before production use.]"},
