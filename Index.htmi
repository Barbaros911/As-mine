/* =====================================================================
   HELPERS: distance, night surcharge, currency
   ===================================================================== */
function toRad(v){ return v * Math.PI / 180; }
function haversineKm(lat1,lon1,lat2,lon2){
  const R=6371;
  const dLat=toRad(lat2-lat1), dLon=toRad(lon2-lon1);
  const a=Math.sin(dLat/2)**2 + Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLon/2)**2;
  return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}
function isNightOrWeekend(dateStr,timeStr){
  if(!dateStr || !timeStr) return false;
  const d = new Date(dateStr+"T"+timeStr);
  if(isNaN(d)) return false;
  const day = d.getDay(); // 0 Sun, 6 Sat
  const hour = d.getHours();
  return day===0 || day===6 || hour>=21 || hour<6;
}
function eur(n){ return n.toLocaleString(currentLang==="en"?"en-GB":currentLang, {minimumFractionDigits:2, maximumFractionDigits:2}) + " €"; }
function debounce(fn,delay){ let tm; return (...a)=>{ clearTimeout(tm); tm=setTimeout(()=>fn(...a),delay); }; }

