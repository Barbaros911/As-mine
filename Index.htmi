<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0">
<title>As-mine — Chauffeur privé haut de gamme</title>
<meta name="theme-color" content="#121212">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://api-adresse.data.gouv.fr https://router.project-osrm.org; frame-ancestors 'self';">
<meta name="description" content="As-mine — chauffeur privé haut de gamme à Paris et en Île-de-France. Réservation instantanée, prix fixe, ponctualité garantie.">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --graphite:#121212;
    --panel:#1A1A1A;
    --panel-2:#202020;
    --line:#2B2B2B;
    --gold:#D4AF37;
    --gold-soft:#E8CE7B;
    --gold-dim:#8A7128;
    --ivory:#F4F1EA;
    --muted:#9C9A93;
    --green:#3DDC84;
    --red:#E5484D;
  }
  *{-webkit-tap-highlight-color:transparent;box-sizing:border-box;}
  html,body{background:var(--graphite);color:var(--ivory);font-family:'Inter',sans-serif;overscroll-behavior-y:none;}
  .font-display{font-family:'Playfair Display',serif;}
  .font-mono{font-family:'JetBrains Mono',monospace;}
  ::-webkit-scrollbar{width:0px;height:0px;}
  .no-select{-webkit-user-select:none;user-select:none;}
  .screen{display:none;}
  .screen.active{display:block;animation:fadeSlide .28s ease both;}
  @keyframes fadeSlide{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}
  .tab-underline{position:relative;}
  .tab-underline.active{background:var(--panel-2);color:var(--gold-soft);}
  .pulse-dot{position:relative;}
  .pulse-dot::before{content:'';position:absolute;inset:-4px;border-radius:9999px;background:var(--green);opacity:.35;animation:pulseRing 1.8s ease-out infinite;}
  @keyframes pulseRing{0%{transform:scale(.6);opacity:.5;}100%{transform:scale(2.2);opacity:0;}}
  .gold-btn{background:linear-gradient(180deg,var(--gold-soft),var(--gold));color:#141210;font-weight:600;}
  .gold-btn:active{transform:scale(.98);}
  .gold-btn:disabled{opacity:.45;filter:grayscale(.3);}
  .card-line{border:1px solid var(--line);}
  .accordion-content{max-height:0;overflow:hidden;transition:max-height .35s ease;}
  .route-svg path{stroke-dasharray:400;stroke-dashoffset:400;animation:drawRoute 1.4s ease forwards;}
  @keyframes drawRoute{to{stroke-dashoffset:0;}}
  input[type=range]{-webkit-appearance:none;background:transparent;}
  input[type=range]::-webkit-slider-runnable-track{height:4px;background:var(--line);border-radius:4px;}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;margin-top:-10px;width:24px;height:24px;border-radius:9999px;background:var(--gold);border:3px solid #121212;box-shadow:0 0 0 1px var(--gold-dim);}
  .modal-backdrop{background:rgba(8,8,8,.72);backdrop-filter:blur(3px);}
  [dir="rtl"] .flip-x{transform:scaleX(-1);}
  .install-toast{animation:toastIn .4s ease both;}
  @keyframes toastIn{from{opacity:0;transform:translateY(100%);}to{opacity:1;transform:translateY(0);}}
  .skeleton-shimmer{background:linear-gradient(90deg,var(--panel) 25%,var(--panel-2) 50%,var(--panel) 75%);background-size:200% 100%;animation:shimmer 1.3s linear infinite;}
  @keyframes shimmer{to{background-position:-200% 0;}}
  .suggest-list{position:absolute;left:0;right:0;top:calc(100% + 4px);background:var(--panel-2);border:1px solid var(--line);border-radius:12px;overflow:hidden;z-index:50;max-height:220px;overflow-y:auto;box-shadow:0 12px 30px rgba(0,0,0,.5);}
  .suggest-item{padding:10px 14px;font-size:13px;border-bottom:1px solid var(--line);cursor:pointer;}
  .suggest-item:last-child{border-bottom:none;}
  .suggest-item:active,.suggest-item:hover{background:#262523;}
  .suggest-item b{color:var(--gold-soft);font-weight:600;}
  .veh-card{border:1px solid var(--line);border-radius:16px;background:var(--panel);transition:border-color .2s,transform .15s;}
  .veh-card:active{transform:scale(.985);}
  .veh-card.selected{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold);}
  .pay-toggle{border:1px solid var(--line);border-radius:14px;background:var(--panel);}
  .pay-toggle.selected{border-color:var(--gold);background:#211d10;}
  .nav-item{display:flex;flex-direction:column;align-items:center;gap:2px;color:var(--muted);font-size:10px;padding:6px 0;flex:1;}
  .nav-item.active{color:var(--gold);}
  .chip-price{border:1px solid var(--line);border-radius:12px;padding:10px 8px;background:var(--panel-2);text-align:center;}
  .chip-price:active{transform:scale(.96);}
  .loader-ring{width:56px;height:56px;border:3px solid var(--line);border-top-color:var(--gold);border-radius:9999px;animation:spin 0.8s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .faq-caret{transition:transform .25s ease;}
  .faq-open .faq-caret{transform:rotate(180deg);}
  .field-float:focus + label, .field-float:not(:placeholder-shown) + label{color:var(--gold-soft);}

  /* Accessibility: visible keyboard focus */
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, [tabindex]:focus-visible{
    outline:2px solid var(--gold); outline-offset:2px; border-radius:6px;
  }
  .suggest-item[aria-selected="true"]{background:#262523;}

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important;}
    .route-svg path{stroke-dashoffset:0;}
  }

  .honeypot-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;}

  /* Stepper */
  .stepper{display:flex;align-items:center;gap:0;margin-bottom:1.25rem;}
  .stepper .step{display:flex;align-items:center;gap:6px;flex:1;}
  .step-dot{width:22px;height:22px;border-radius:9999px;border:1.5px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:10px;font-family:'JetBrains Mono',monospace;color:var(--muted);flex-shrink:0;}
  .step.done .step-dot{background:var(--gold);border-color:var(--gold);color:#141210;}
  .step.current .step-dot{border-color:var(--gold);color:var(--gold-soft);}
  .step-label{font-size:10px;color:var(--muted);}
  .step.done .step-label, .step.current .step-label{color:var(--ivory);}
  .step-line{flex:1;height:1px;background:var(--line);margin:0 4px;}
  .step-line.done{background:var(--gold);}

  /* Extras chips */
  .extra-chip{border:1px solid var(--line);border-radius:12px;padding:10px;background:var(--panel-2);text-align:left;display:flex;align-items:center;justify-content:space-between;gap:8px;}
  .extra-chip.selected{border-color:var(--gold);background:#211d10;}
  .extra-chip .box{width:18px;height:18px;border:1.5px solid var(--line);border-radius:5px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
  .extra-chip.selected .box{background:var(--gold);border-color:var(--gold);}

  /* Consent granular toggle */
  .switch{width:38px;height:22px;border-radius:9999px;background:var(--line);position:relative;transition:background .2s;flex-shrink:0;}
  .switch.on{background:var(--gold);}
  .switch::after{content:'';position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:9999px;background:var(--ivory);transition:transform .2s;}
  .switch.on::after{transform:translateX(16px);}
  [dir="rtl"] .switch::after{left:auto;right:2px;}
  [dir="rtl"] .switch.on::after{transform:translateX(-16px);}
</style>
</head>
<body class="min-h-screen">

<!-- ===================== HEADER ===================== -->
<header class="fixed top-0 left-0 right-0 z-40 bg-[#121212]/90 backdrop-blur border-b border-[#2B2B2B]">
  <div class="max-w-md mx-auto px-4 h-16 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none"><path d="M13 2 L23 8 V18 L13 24 L3 18 V8 Z" stroke="#D4AF37" stroke-width="1.3"/><circle cx="13" cy="13" r="3" fill="#D4AF37"/></svg>
      <span class="font-display text-xl tracking-wide" style="color:var(--ivory)">AS-MINE</span>
    </div>
    <div class="flex items-center gap-3">
      <button id="driversBadge" class="flex items-center gap-1.5 text-xs text-[#9C9A93]">
        <span class="pulse-dot w-2 h-2 rounded-full bg-[#3DDC84]"></span>
        <span data-i18n="drivers_available">Chauffeurs disponibles</span>
      </button>
      <select id="langSelect" class="bg-[#1A1A1A] border border-[#2B2B2B] text-xs rounded-full px-2.5 py-1.5 text-[var(--ivory)] outline-none">
        <option value="fr">🇫🇷 FR</option>
        <option value="en">🇬🇧 EN</option>
        <option value="tr">🇹🇷 TR</option>
        <option value="ar">🇸🇦 AR</option>
        <option value="zh">🇨🇳 ZH</option>
        <option value="es">🇪🇸 ES</option>
        <option value="de">🇩🇪 DE</option>
        <option value="it">🇮🇹 IT</option>
        <option value="ru">🇷🇺 RU</option>
        <option value="pt">🇵🇹 PT</option>
      </select>
    </div>
  </div>
</header>

<main class="max-w-md mx-auto pt-20 pb-28 px-4">

  <!-- ===================== SCREEN: HOME ===================== -->
  <section id="screen-home" class="screen active">
    <div class="mb-2 flex items-center gap-1.5 text-xs text-[var(--gold)] font-mono uppercase tracking-widest">
      <span data-i18n="tagline">Chauffeur privé — Paris & Île-de-France</span>
    </div>
    <h1 class="font-display text-3xl leading-tight mb-3" data-i18n="hero_title">L'excellence, à chaque trajet.</h1>
    <p class="text-sm text-[var(--muted)] mb-5" data-i18n="hero_sub">Réservez un chauffeur professionnel en moins de deux minutes. Prix fixe, ponctualité garantie, confirmation instantanée.</p>

    <svg class="w-full h-28 mb-6" viewBox="0 0 400 100" fill="none">
      <line x1="20" y1="70" x2="380" y2="70" stroke="#2B2B2B" stroke-width="1"/>
      <path class="route-svg" d="M30 70 C 120 70, 140 20, 200 20 S 300 70, 370 70" stroke="#D4AF37" stroke-width="2" stroke-linecap="round"/>
      <circle cx="30" cy="70" r="5" fill="#F4F1EA"/>
      <circle cx="370" cy="70" r="6" fill="#D4AF37"/>
    </svg>

    <!-- Booking card -->
    <div class="rounded-2xl bg-[var(--panel)] card-line p-4 shadow-xl mb-6">
      <div class="grid grid-cols-2 gap-1 mb-4 bg-[#141414] rounded-full p-1" role="tablist" aria-label="Type de réservation">
        <button id="tabSimple" role="tab" aria-selected="true" class="tab-underline active py-2.5 rounded-full text-sm font-medium" data-i18n="tab_simple">Trajet Simple</button>
        <button id="tabDisposal" role="tab" aria-selected="false" class="tab-underline py-2.5 rounded-full text-sm font-medium text-[var(--muted)]" data-i18n="tab_disposal">Mise à Disposition</button>
      </div>

      <!-- SIMPLE TRIP FORM -->
      <div id="formSimple" class="space-y-3">
        <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="relative">
          <input id="pickup" autocomplete="off" type="text" placeholder=" " role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="pickupList" class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_pickup">Adresse de départ</label>
          <div id="pickupList" class="suggest-list hidden" role="listbox"></div>
        </div>
        <div class="relative">
          <input id="dropoff" autocomplete="off" type="text" placeholder=" " role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="dropoffList" class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_dropoff">Adresse d'arrivée</label>
          <div id="dropoffList" class="suggest-list hidden" role="listbox"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="relative">
            <input id="dateSimple" type="date" class="w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
            <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_date">Date</label>
          </div>
          <div class="relative">
            <select id="timeSimple" class="w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none appearance-none"></select>
            <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_time">Heure</label>
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none flip-x" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
        <div class="relative">
          <input id="promoSimple" type="text" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none uppercase">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_promo">Code promo (optionnel)</label>
        </div>
      </div>

      <!-- DISPOSAL FORM -->
      <div id="formDisposal" class="space-y-3 hidden">
        <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="relative">
          <input id="pickupDisp" autocomplete="off" type="text" placeholder=" " role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="pickupDispList" class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_pickup_disp">Lieu de prise en charge</label>
          <div id="pickupDispList" class="suggest-list hidden" role="listbox"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="relative">
            <input id="dateDisp" type="date" class="w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
            <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_date">Date</label>
          </div>
          <div class="relative">
            <select id="timeDisp" class="w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none appearance-none"></select>
            <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_time">Heure</label>
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none flip-x" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
        <div class="pt-2">
          <div class="flex justify-between text-xs text-[var(--muted)] mb-1">
            <span data-i18n="label_duration">Durée de mise à disposition</span>
            <span id="durationVal" class="text-[var(--gold)] font-mono font-medium">3 h</span>
          </div>
          <input id="durationRange" type="range" min="1" max="12" value="3" class="w-full" aria-label="Durée en heures">
        </div>
        <div class="relative">
          <input id="promoDisp" type="text" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none uppercase">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_promo">Code promo (optionnel)</label>
        </div>
      </div>

      <p id="formError" class="text-xs text-[var(--red)] mt-3 hidden"></p>

      <button id="btnSearch" class="gold-btn w-full mt-5 py-3.5 rounded-xl flex items-center justify-center gap-2 transition-transform shadow-lg">
        <span data-i18n="btn_search">Voir les tarifs</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="flip-x"><path d="M5 12h14M13 6l6 6-6 6" stroke="#141210" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <!-- Promo airport card -->
    <button id="promoAirports" class="w-full rounded-2xl card-line bg-[var(--panel)] p-4 flex items-center justify-between text-left mb-4">
      <div>
        <p class="text-xs text-[var(--gold)] font-mono uppercase tracking-widest mb-1" data-i18n="airports_eyebrow">Forfaits fixes</p>
        <p class="font-display text-lg" data-i18n="airports_title">Aéroports Paris & Beauvais</p>
        <p class="text-xs text-[var(--muted)]" data-i18n="airports_sub">CDG · Orly · Beauvais — prix bloqué, zéro surprise.</p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="flip-x shrink-0 ml-3"><path d="M9 6l6 6-6 6" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </section>

  <!-- ===================== SCREEN: AIRPORTS ===================== -->
  <section id="screen-airports" class="screen">
    <button class="btn-back flex items-center gap-1.5 text-xs text-[var(--muted)] mb-4" data-target="screen-home">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flip-x"><path d="M15 6l-6 6 6 6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-i18n="back">Retour</span>
    </button>
    <h2 class="font-display text-2xl mb-1" data-i18n="airports_title">Aéroports Paris & Beauvais</h2>
    <p class="text-sm text-[var(--muted)] mb-5" data-i18n="airports_sub">CDG · Orly · Beauvais — prix bloqué, zéro surprise.</p>

    <div class="rounded-2xl bg-[var(--panel)] card-line p-4 mb-4">
      <div class="relative mb-3">
        <input id="addressAirport" autocomplete="off" type="text" placeholder=" " role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="addressAirportList" class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
        <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_address_complement">Votre adresse à Paris / IDF</label>
        <div id="addressAirportList" class="suggest-list hidden" role="listbox"></div>
      </div>
      <div class="grid grid-cols-2 gap-3 mb-3">
        <div class="relative">
          <input id="dateAirport" type="date" class="w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_date">Date</label>
        </div>
        <div class="relative">
          <select id="timeAirport" class="w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none appearance-none"></select>
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="label_time">Heure</label>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none flip-x" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-1 bg-[#141414] rounded-full p-1">
        <button id="dirToAirport" class="tab-underline active py-2 rounded-full text-xs font-medium" data-i18n="dir_to_airport">Paris → Aéroport</button>
        <button id="dirFromAirport" class="tab-underline py-2 rounded-full text-xs font-medium text-[var(--muted)]" data-i18n="dir_from_airport">Aéroport → Paris</button>
      </div>
    </div>

    <div id="airportCards" class="space-y-3"></div>
  </section>

  <!-- ===================== SCREEN: VEHICLES ===================== -->
  <section id="screen-vehicles" class="screen">
    <button class="btn-back flex items-center gap-1.5 text-xs text-[var(--muted)] mb-4" data-target="screen-home">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flip-x"><path d="M15 6l-6 6 6 6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-i18n="back">Retour</span>
    </button>
    <div class="stepper" id="stepperVehicles" aria-hidden="true"></div>
    <h2 class="font-display text-2xl mb-1" data-i18n="vehicles_title">Choisissez votre véhicule</h2>
    <p id="vehiclesSub" class="text-sm text-[var(--muted)] mb-1"></p>
    <p id="nightNote" class="text-xs text-[var(--gold-soft)] mb-2 hidden" data-i18n="night_surcharge_note">Majoration nuit/week-end de +20% appliquée automatiquement et affichée en toute transparence.</p>
    <p id="vatNote" class="text-xs text-[var(--muted)] mb-5" data-i18n="vat_note">Prix TTC, TVA 10% incluse (transport de personnes).</p>
    <div id="routeSkeleton" class="hidden space-y-3 mb-6">
      <div class="skeleton-shimmer h-20 rounded-2xl"></div>
      <div class="skeleton-shimmer h-20 rounded-2xl"></div>
    </div>
    <div id="vehicleCards" class="space-y-3 mb-6"></div>
    <button id="btnToPayment" disabled class="gold-btn w-full py-3.5 rounded-xl flex items-center justify-center gap-2 shadow-lg">
      <span data-i18n="btn_continue">Continuer</span>
    </button>
  </section>

  <!-- ===================== SCREEN: PAYMENT ===================== -->
  <section id="screen-payment" class="screen">
    <button class="btn-back flex items-center gap-1.5 text-xs text-[var(--muted)] mb-4" data-target="screen-vehicles">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flip-x"><path d="M15 6l-6 6 6 6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-i18n="back">Retour</span>
    </button>
    <div class="stepper" id="stepperPayment" aria-hidden="true"></div>
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-display text-2xl" data-i18n="summary_title">Récapitulatif</h2>
      <button id="btnEditTrip" class="text-xs text-[var(--gold-soft)] underline" data-i18n="edit_trip">Modifier</button>
    </div>

    <div id="tripSummary" class="rounded-2xl bg-[var(--panel)] card-line p-4 mb-4 text-sm space-y-2"></div>

    <div class="rounded-2xl bg-[var(--panel)] card-line p-4 mb-4">
      <p class="text-xs text-[var(--gold)] uppercase tracking-widest font-mono mb-3" data-i18n="promo_title">Code promo</p>
      <div class="flex gap-2">
        <input id="promoPayment" type="text" placeholder=" " class="flex-1 bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 py-2.5 text-sm outline-none uppercase" data-i18n-placeholder="label_promo">
        <button id="btnApplyPromo" class="px-4 rounded-xl border border-[var(--gold)] text-[var(--gold-soft)] text-xs font-medium" data-i18n="promo_apply">Appliquer</button>
      </div>
      <p id="promoMsg" class="text-xs mt-2 hidden"></p>
    </div>

    <div class="rounded-2xl bg-[var(--panel)] card-line p-4 mb-4">
      <p class="text-xs text-[var(--gold)] uppercase tracking-widest font-mono mb-3" data-i18n="client_info">Vos informations</p>
      <div class="space-y-3">
        <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="relative">
          <input id="clientName" type="text" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="full_name">Nom complet</label>
        </div>
        <div class="relative">
          <input id="clientPhone" type="tel" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="phone_number">Téléphone (avec indicatif)</label>
        </div>
      </div>
    </div>

    <div class="rounded-2xl bg-[var(--panel)] card-line p-4 mb-4">
      <p class="text-xs text-[var(--gold)] uppercase tracking-widest font-mono mb-3" data-i18n="payment_title">Paiement</p>
      <div class="grid grid-cols-2 gap-3 mb-4">
        <button id="payCard" class="pay-toggle selected py-3 rounded-xl flex flex-col items-center gap-1">
          <span class="text-lg">💳</span>
          <span class="text-xs font-medium" data-i18n="pay_card">Carte Bancaire</span>
        </button>
        <button id="payPaypal" class="pay-toggle py-3 rounded-xl flex flex-col items-center gap-1">
          <span class="text-lg">🅿️</span>
          <span class="text-xs font-medium" data-i18n="pay_paypal">PayPal</span>
        </button>
      </div>

      <div id="cardFields" class="space-y-3">
        <div class="relative">
          <input id="cardName" type="text" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="card_name">Nom sur la carte</label>
        </div>
        <div class="relative">
          <input id="cardNumber" type="text" inputmode="numeric" maxlength="19" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none font-mono">
          <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="card_number">Numéro de carte</label>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="relative">
            <input id="cardExpiry" type="text" inputmode="numeric" maxlength="5" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none font-mono">
            <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="card_expiry">MM/AA</label>
          </div>
          <div class="relative">
            <input id="cardCvc" type="text" inputmode="numeric" maxlength="3" placeholder=" " class="field-float w-full bg-[#141414] border border-[#2B2B2B] focus:border-[var(--gold)] rounded-xl px-3.5 pt-4 pb-2 text-sm outline-none font-mono">
            <label class="absolute left-3.5 top-1 text-[10px] text-[var(--muted)]" data-i18n="card_cvc">CVC</label>
          </div>
        </div>
      </div>
    </div>

    <button id="btnConfirmPay" class="gold-btn w-full py-3.5 rounded-xl flex items-center justify-center gap-2 shadow-lg">
      <span data-i18n="btn_confirm_pay">Confirmer et Payer</span>
    </button>
  </section>

  <!-- ===================== SCREEN: CONFIRMATION ===================== -->
  <section id="screen-confirmation" class="screen">
    <div class="flex flex-col items-center text-center pt-10">
      <div class="w-16 h-16 rounded-full bg-[#1c2a20] border border-[var(--green)] flex items-center justify-center mb-5">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="#3DDC84" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2 class="font-display text-2xl mb-2" data-i18n="confirmation_title">Réservation confirmée</h2>
      <p class="text-sm text-[var(--muted)] mb-4" data-i18n="confirmation_sub">Votre chauffeur As-mine vous attend. Le récapitulatif a été envoyé sur WhatsApp.</p>
      <p class="font-mono text-xs text-[var(--gold)] mb-8"><span data-i18n="confirmation_ref">Référence</span> : <span id="confRef"></span></p>
      <button id="btnNewBooking" class="gold-btn px-6 py-3 rounded-xl text-sm" data-i18n="btn_new_booking">Nouvelle réservation</button>
    </div>
