/* =====================================================================
   TIME SLOTS — 15-minute increments, minimum 20-minute lead time for today
   ===================================================================== */
function generateTimeSlots(dateStr){
  const dayStart = new Date(dateStr+"T00:00:00");
  const minTime = new Date(Date.now() + 20*60000);
  let minMinutes = 0;
  if(minTime.getTime() > dayStart.getTime()){
    minMinutes = Math.ceil((minTime.getTime()-dayStart.getTime())/60000/15)*15;
  }
  const slots=[];
  for(let m=0; m<24*60; m+=15){
    if(m < minMinutes) continue;
    const hh=String(Math.floor(m/60)).padStart(2,"0"), mm=String(m%60).padStart(2,"0");
    slots.push(`${hh}:${mm}`);
  }
  return slots;
}
function populateTimeSelect(selectEl, dateStr){
  const prev = selectEl.value;
  const slots = generateTimeSlots(dateStr);
  if(slots.length===0){
    selectEl.innerHTML = `<option value="">—</option>`;
    selectEl.disabled = true;
    return;
  }
  selectEl.disabled = false;
  selectEl.innerHTML = slots.map(s=>`<option value="${s}">${s}</option>`).join("");
  selectEl.value = slots.includes(prev) ? prev : slots[0];
}
function wireDateTimePair(dateId, timeId){
  const dateEl=document.getElementById(dateId), timeEl=document.getElementById(timeId);
  function refresh(){
    if(generateTimeSlots(dateEl.value).length===0){
      const next=new Date(dateEl.value+"T00:00:00"); next.setDate(next.getDate()+1);
      dateEl.value = next.toISOString().slice(0,10);
    }
    populateTimeSelect(timeEl, dateEl.value);
  }
  refresh();
  dateEl.addEventListener("change", refresh);
}
wireDateTimePair("dateSimple","timeSimple");
wireDateTimePair("dateDisp","timeDisp");
wireDateTimePair("dateAirport","timeAirport");

/* =====================================================================
   SEARCH (Simple / Disposal) → VEHICLE SCREEN
   ===================================================================== */
function isFutureDateTime(dateStr,timeStr){
  if(!dateStr || !timeStr) return false;
  const d = new Date(dateStr+"T"+timeStr);
  if(isNaN(d)) return false;
  return d.getTime() >= (Date.now() - 60000); // small tolerance
}
const btnSearchEl = document.getElementById("btnSearch");
btnSearchEl.addEventListener("click", async ()=>{
  const errEl=document.getElementById("formError");
  errEl.classList.add("hidden");

  // Honeypot anti-bot check (silently ignore submission if filled)
  const activeForm = state.tripType==="simple" ? formSimple : formDisposal;
  const honeypot = activeForm.querySelector('input[name="website"]');
  if(honeypot && honeypot.value.trim() !== "") return;

  if(state.tripType==="simple"){
    state.date=document.getElementById("dateSimple").value;
    state.time=document.getElementById("timeSimple").value;
    if(!state.pickup || !state.dropoff || !state.date || !state.time){
      errEl.textContent=t("field_required"); errEl.classList.remove("hidden"); return;
    }
    if(!isFutureDateTime(state.date,state.time)){
      errEl.textContent=t("error_future_time"); errEl.classList.remove("hidden"); return;
    }
    btnSearchEl.disabled=true;
    const routeBtnLabel = btnSearchEl.querySelector("span").textContent;
    btnSearchEl.querySelector("span").textContent = "…";
    const route = await fetchRouteDistanceKm(state.pickup, state.dropoff);
    btnSearchEl.disabled=false;
    btnSearchEl.querySelector("span").textContent = routeBtnLabel;
    state.distanceKm = route.km;
    state.distanceEstimated = route.estimated;
    state.isNight = isNightOrWeekend(state.date,state.time);
    state.promoCode = (document.getElementById("promoSimple").value || "").trim().toUpperCase() || null;
  }else{
    state.date=document.getElementById("dateDisp").value;
    state.time=document.getElementById("timeDisp").value;
    if(!state.pickup || !state.date || !state.time){
      errEl.textContent=t("field_required"); errEl.classList.remove("hidden"); return;
    }
    if(!isFutureDateTime(state.date,state.time)){
      errEl.textContent=t("error_future_time"); errEl.classList.remove("hidden"); return;
    }
    state.isNight = isNightOrWeekend(state.date,state.time);
    state.promoCode = (document.getElementById("promoDisp").value || "").trim().toUpperCase() || null;
  }
  state.airportKey=null;
  trackEvent("view_vehicles", {tripType:state.tripType});
  renderVehicleScreen();
  showScreen("screen-vehicles");
});

/* =====================================================================
   VEHICLE SCREEN RENDER
   ===================================================================== */
function applyPromo(price){
  if(state.promoCode && PROMO_CODES[state.promoCode]){
    state.promoDiscount = PROMO_CODES[state.promoCode];
    return price * (1 - state.promoDiscount);
  }
  state.promoDiscount = 0;
  return price;
}
function priceForVehicle(v){
  let base;
  if(state.tripType==="simple"){
    base = v.base + v.perKm*state.distanceKm;
    if(state.isNight) base *= 1.2;
  }else{
    base = v.hourly * state.duration;
    if(state.isNight) base *= 1.2;
  }
  return base;
}
function renderStepper(el, active){
  const steps = [t("step_trip"), t("step_vehicle"), t("step_payment")];
  el.innerHTML = steps.map((label,i)=>{
    const idx=i+1;
    const cls = idx<active ? "done" : (idx===active ? "current" : "");
    const dot = idx<active ? "✓" : idx;
    const line = i<steps.length-1 ? `<div class="step-line ${idx<active?'done':''}"></div>` : "";
    return `<div class="step ${cls}"><div class="step-dot">${dot}</div><span class="step-label hidden sm:inline">${label}</span></div>${line}`;
  }).join("");
}
function renderVehicleScreen(){
  renderStepper(document.getElementById("stepperVehicles"), 2);
  const sub=document.getElementById("vehiclesSub");
  const nightNote=document.getElementById("nightNote");
  if(state.tripType==="simple"){
    const approx = state.distanceEstimated ? " (≈)" : "";
    sub.textContent = `${t("vehicles_sub_simple")} ${state.distanceKm.toFixed(1)} km${approx}`;
  }else{
    sub.textContent = `${t("vehicles_sub_disposal")} ${state.duration} ${t("duration_label_h")}`;
  }
  nightNote.classList.toggle("hidden", !state.isNight);

  const wrap=document.getElementById("vehicleCards");
  wrap.innerHTML="";
  state.vehicle=null;
  document.getElementById("btnToPayment").disabled=true;

  VEHICLES.forEach(v=>{
    const priceRaw = priceForVehicle(v);
    const price = applyPromo(priceRaw);
    const card=document.createElement("button");
    card.className="veh-card w-full p-4 flex items-center justify-between text-left";
    card.dataset.key=v.key;
    card.innerHTML = `
      <div class="flex items-center gap-3">
        <span class="text-2xl">${v.icon}</span>
        <div>
          <p class="font-medium text-sm">${t(v.nameKey)}</p>
          <p class="text-[11px] text-[var(--muted)]">${t("price_from")}</p>
        </div>
      </div>
      <p class="font-mono text-[var(--gold)] font-semibold">${eur(price)}</p>
    `;
    card.addEventListener("click", ()=>{
      wrap.querySelectorAll(".veh-card").forEach(c=>c.classList.remove("selected"));
      card.classList.add("selected");
      state.vehicle=v.key;
      state.priceBeforePromo=priceRaw;
      state.price=price;
      document.getElementById("btnToPayment").disabled=false;
      trackEvent("select_vehicle", {vehicle:v.key, price});
    });
    wrap.appendChild(card);
  });
}
document.getElementById("btnToPayment").addEventListener("click", ()=>{
  renderPaymentScreen();
  showScreen("screen-payment");
});

/* =====================================================================
   AIRPORTS SCREEN
   ===================================================================== */
const dirToBtn=document.getElementById("dirToAirport"), dirFromBtn=document.getElementById("dirFromAirport");
dirToBtn.addEventListener("click", ()=>{ state.airportDirection="to"; dirToBtn.classList.add("active"); dirFromBtn.classList.remove("active"); });
dirFromBtn.addEventListener("click", ()=>{ state.airportDirection="from"; dirFromBtn.classList.add("active"); dirToBtn.classList.remove("active"); });

function renderAirportCards(){
  const wrap=document.getElementById("airportCards");
  wrap.innerHTML="";
  Object.entries(AIRPORTS).forEach(([key,ap])=>{
    const card=document.createElement("div");
    card.className="rounded-2xl bg-[var(--panel)] card-line p-4";
    card.innerHTML = `
      <p class="font-display text-lg mb-3">${t(ap.nameKey)}</p>
      <div class="grid grid-cols-2 gap-2">
        ${VEHICLES.map(v=>`
          <button class="chip-price airport-chip" data-airport="${key}" data-vehicle="${v.key}">
            <p class="text-[11px] text-[var(--muted)] mb-1">${t(v.nameKey)}</p>
            <p class="font-mono text-[var(--gold)] font-semibold text-sm">${eur(ap.prices[v.key])}</p>
          </button>
        `).join("")}
      </div>
    `;
    wrap.appendChild(card);
  });
  wrap.querySelectorAll(".airport-chip").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      const apKey=btn.dataset.airport, vKey=btn.dataset.vehicle;
      const ap=AIRPORTS[apKey];
      state.tripType="airport";
      state.airportKey=apKey;
      state.vehicle=vKey;
      state.priceBeforePromo=ap.prices[vKey];
      state.price=ap.prices[vKey]; // forfait bloqué : ni majoration, ni extras, ni promo
      state.promoCode=null; state.promoDiscount=0;
      state.date=document.getElementById("dateAirport").value;
      state.time=document.getElementById("timeAirport").value;
      state.isNight=false;
      trackEvent("select_airport_package", {airport:apKey, vehicle:vKey});
      const complement = state.airportComplementAddress || {label: document.getElementById("addressAirport").value || "—", lat:48.8566, lon:2.3522};
      if(state.airportDirection==="to"){
        state.pickup = complement;
        state.dropoff = {label: ap.address, lat: ap.lat, lon: ap.lon};
      }else{
        state.pickup = {label: ap.address, lat: ap.lat, lon: ap.lon};
        state.dropoff = complement;
      }
      renderPaymentScreen();
      showScreen("screen-payment");
    });
  });
}
renderAirportCards();

/* =====================================================================
   PAYMENT SCREEN
   ===================================================================== */
function tripTypeLabel(){
  if(state.tripType==="simple") return t("trip_type_simple");
  if(state.tripType==="disposal") return t("trip_type_disposal");
  return t("trip_type_airport");
}
function updateTripSummary(){
  const wrap=document.getElementById("tripSummary");
  const vName = VEHICLES.find(v=>v.key===state.vehicle);
  let rows = `<div class="flex justify-between"><span class="text-[var(--muted)]">${tripTypeLabel()}</span><span class="font-medium">${t(vName.nameKey)}</span></div>`;
  rows += `<div class="flex justify-between"><span class="text-[var(--muted)]">${t("wa_from")}</span><span class="text-right max-w-[60%]">${state.pickup ? state.pickup.label : "—"}</span></div>`;
  rows += `<div class="flex justify-between"><span class="text-[var(--muted)]">${t("wa_to")}</span><span class="text-right max-w-[60%]">${state.dropoff ? state.dropoff.label : "—"}</span></div>`;
  rows += `<div class="flex justify-between"><span class="text-[var(--muted)]">${t("wa_date")}</span><span>${state.date} — ${state.time}</span></div>`;
  if(state.tripType==="disposal"){
    rows += `<div class="flex justify-between"><span class="text-[var(--muted)]">${t("wa_duration")}</span><span>${state.duration} ${t("duration_label_h")}</span></div>`;
  }
  if(state.tripType==="simple"){
    rows += `<div class="flex justify-between"><span class="text-[var(--muted)]">${t("distance_label")}</span><span>${state.distanceKm.toFixed(1)} km${state.distanceEstimated?" (≈)":""}</span></div>`;
  }
  if(state.promoCode && state.promoDiscount>0){
    rows += `<div class="flex justify-between"><span class="text-[var(--muted)]">${t("wa_promo")}</span><span class="text-[var(--green)]">${state.promoCode} (-${Math.round(state.promoDiscount*100)}%)</span></div>`;
  }
  rows += `<div class="border-t border-[var(--line)] my-2"></div>`;
  const ht = state.price / (1+VAT_RATE);
  const vat = state.price - ht;
  rows += `<div class="flex justify-between text-xs text-[var(--muted)]"><span>${t("wa_ht")}</span><span class="font-mono">${eur(ht)}</span></div>`;
  rows += `<div class="flex justify-between text-xs text-[var(--muted)] mb-1"><span>${t("wa_vat")}</span><span class="font-mono">${eur(vat)}</span></div>`;
  rows += `<div class="flex justify-between text-base"><span class="font-medium">${t("wa_total")}</span><span class="font-mono text-[var(--gold)] font-bold">${eur(state.price)}</span></div>`;
  wrap.innerHTML = rows;
}
function renderPaymentScreen(){
  renderStepper(document.getElementById("stepperPayment"), 3);
  updateTripSummary();
  const promoInput = document.getElementById("promoPayment");
  promoInput.value = state.promoCode || "";
  document.getElementById("promoMsg").classList.add("hidden");
  const disablePromo = state.tripType==="airport";
  promoInput.disabled = disablePromo;
  document.getElementById("btnApplyPromo").disabled = disablePromo;
  trackEvent("view_payment", {tripType:state.tripType, price:state.price});
}

/* Edit trip: go back to booking form without losing entered data */
document.getElementById("btnEditTrip").addEventListener("click", ()=>{
  showScreen(state.tripType==="airport" ? "screen-airports" : "screen-home");
});

/* Promo code applied from the payment screen (after vehicle already chosen) */
document.getElementById("btnApplyPromo").addEventListener("click", ()=>{
  const code = document.getElementById("promoPayment").value.trim().toUpperCase();
  const msg = document.getElementById("promoMsg");
  state.promoCode = code || null;
  const base = state.priceBeforePromo || state.price;
  const newPrice = applyPromo(base);
  msg.classList.remove("hidden");
  if(code && PROMO_CODES[code]){
    msg.textContent = t("promo_valid");
    msg.className = "text-xs mt-2 text-[var(--green)]";
  }else if(code){
    msg.textContent = t("promo_invalid");
    msg.className = "text-xs mt-2 text-[var(--red)]";
    state.promoDiscount = 0;
  }else{
    msg.classList.add("hidden");
  }
  state.price = newPrice;
  updateTripSummary();
});

/* Payment method toggle */
const payCard=document.getElementById("payCard"), payPaypal=document.getElementById("payPaypal"), cardFields=document.getElementById("cardFields");
payCard.addEventListener("click", ()=>{ state.paymentMethod="card"; payCard.classList.add("selected"); payPaypal.classList.remove("selected"); cardFields.classList.remove("hidden"); });
payPaypal.addEventListener("click", ()=>{ state.paymentMethod="paypal"; payPaypal.classList.add("selected"); payCard.classList.remove("selected"); cardFields.classList.add("hidden"); });

/* Card input masks */
const cardNumber=document.getElementById("cardNumber");
cardNumber.addEventListener("input", ()=>{
  let v=cardNumber.value.replace(/\D/g,"").slice(0,16);
  cardNumber.value = v.replace(/(\d{4})(?=\d)/g,"$1 ");
});
const cardExpiry=document.getElementById("cardExpiry");
cardExpiry.addEventListener("input", ()=>{
  let v=cardExpiry.value.replace(/\D/g,"").slice(0,4);
  if(v.length>=3) v = v.slice(0,2)+"/"+v.slice(2);
  cardExpiry.value=v;
});
const cardCvc=document.getElementById("cardCvc");
cardCvc.addEventListener("input", ()=>{ cardCvc.value = cardCvc.value.replace(/\D/g,"").slice(0,3); });

/* =====================================================================
   CONFIRM & PAY → WHATSAPP
   ===================================================================== */
function buildWhatsAppMessage(ref){
  const vName = t(VEHICLES.find(v=>v.key===state.vehicle).nameKey);
  const clientName = document.getElementById("clientName").value || "—";
  const clientPhone = document.getElementById("clientPhone").value || "—";
  let lines = [];
  lines.push("AS-MINE CHAUFFEURS");
  lines.push(`${t("wa_ref")}: ${ref}`);
  lines.push(`${t("wa_status")}: ✅ ${t("wa_paid")}`);
  lines.push("");
  lines.push(`${t("wa_client")}: ${clientName}`);
  lines.push(`${t("wa_phone")}: ${clientPhone}`);
  lines.push("");
  lines.push(`${t("wa_trip")} (${tripTypeLabel()}):`);
  lines.push(`${t("wa_from")}: ${state.pickup ? state.pickup.label : "—"}`);
  lines.push(`${t("wa_to")}: ${state.dropoff ? state.dropoff.label : "—"}`);
  lines.push(`${t("wa_date")}: ${state.date}   ${t("wa_time")}: ${state.time}`);
  if(state.tripType==="disposal") lines.push(`${t("wa_duration")}: ${state.duration} ${t("duration_label_h")}`);
  if(state.promoCode && state.promoDiscount>0) lines.push(`${t("wa_promo")}: ${state.promoCode} (-${Math.round(state.promoDiscount*100)}%)`);
  lines.push("");
  lines.push(`${t("wa_vehicle")}: ${vName}`);
  lines.push(`${t("wa_total")}: ${eur(state.price)}`);
  lines.push("");
  lines.push(t("wa_thanks"));
  return lines.join("\n");
}
document.getElementById("btnConfirmPay").addEventListener("click", ()=>{
  // Honeypot anti-bot check
  const honeypot = document.querySelector('#screen-payment input[name="website"]');
  if(honeypot && honeypot.value.trim() !== "") return;

  const name=document.getElementById("clientName").value.trim();
  const phone=document.getElementById("clientPhone").value.trim();
  if(!name || !phone){ alert(t("field_required")); return; }
  const phoneOk = /^[+0-9 ()-]{6,20}$/.test(phone);
  if(!phoneOk){ alert(t("field_required")); return; }
  if(state.paymentMethod==="card"){
    const num=cardNumber.value.replace(/\s/g,"");
    if(num.length<16 || cardExpiry.value.length<5 || cardCvc.value.length<3 || !document.getElementById("cardName").value.trim()){
      alert(t("field_required")); return;
    }
  }
  trackEvent("confirm_payment", {tripType:state.tripType, vehicle:state.vehicle, price:state.price, method:state.paymentMethod});
  const loader=document.getElementById("loaderOverlay");
  loader.classList.remove("hidden");
  loader.classList.add("flex");
  setTimeout(()=>{
    loader.classList.add("hidden");
    loader.classList.remove("flex");
    const ref = "ASM-" + Date.now().toString().slice(-6);
    document.getElementById("confRef").textContent = ref;
    const msg = buildWhatsAppMessage(ref);
    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`;
    window.open(url, "_blank");

    // Session-only trip history (in-memory; not persisted, per artifact storage constraints)
    sessionHistory.unshift({
      ref, tripType:state.tripType, vehicle:state.vehicle, price:state.price,
      pickup: state.pickup ? state.pickup.label : "—",
      dropoff: state.dropoff ? state.dropoff.label : "—",
      date: state.date, time: state.time
    });
    renderHistory();
    trackEvent("booking_confirmed", {ref, price:state.price});
    showScreen("screen-confirmation");
  }, 1500);
});
document.getElementById("btnNewBooking").addEventListener("click", ()=>{
  state.pickup=null; state.dropoff=null; state.vehicle=null; state.price=0; state.airportKey=null;
  state.promoCode=null; state.promoDiscount=0;
  document.getElementById("pickup").value=""; document.getElementById("dropoff").value=""; document.getElementById("pickupDisp").value="";
  document.getElementById("promoSimple").value=""; document.getElementById("promoDisp").value="";
  document.getElementById("clientName").value=""; document.getElementById("clientPhone").value="";
  cardNumber.value=""; cardExpiry.value=""; cardCvc.value=""; document.getElementById("cardName").value="";
  showScreen("screen-home");
});

/* =====================================================================
   SESSION TRIP HISTORY
   ===================================================================== */
function renderHistory(){
  const wrap=document.getElementById("historyList");
  const empty=document.getElementById("historyEmpty");
  wrap.innerHTML="";
  empty.classList.toggle("hidden", sessionHistory.length>0);
  sessionHistory.forEach(h=>{
    const vName = t(VEHICLES.find(v=>v.key===h.vehicle).nameKey);
    const div=document.createElement("div");
    div.className="rounded-2xl bg-[var(--panel)] card-line p-4 text-sm";
    div.innerHTML = `
      <div class="flex justify-between mb-1"><span class="font-mono text-xs text-[var(--gold)]">${h.ref}</span><span class="font-mono text-[var(--gold)] font-semibold">${eur(h.price)}</span></div>
      <p class="text-xs text-[var(--muted)] mb-0.5">${vName} — ${h.date} ${h.time}</p>
      <p class="text-xs">${h.pickup} → ${h.dropoff}</p>
    `;
    wrap.appendChild(div);
  });
}

/* =====================================================================
   LEGAL SCREEN
   ===================================================================== */
let currentLegalDoc = null;
document.querySelectorAll(".btn-legal").forEach(btn=>{
  btn.addEventListener("click", ()=>{
    const doc=btn.dataset.doc;
    currentLegalDoc = doc;
    const map = { cgv:["legal_cgv","legal_cgv_body"], mentions:["legal_mentions","legal_mentions_body"], privacy:["legal_privacy","legal_privacy_body"] };
    const [titleKey, bodyKey] = map[doc];
    document.getElementById("legalDocTitle").textContent = t(titleKey);
    document.getElementById("legalDocBody").textContent = t(bodyKey);
    showScreen("screen-legal");
  });
});

/* =====================================================================
   FAQ ACCORDION
   ===================================================================== */
const FAQ_ITEMS = [
  {q:"faq_q1", a:"faq_a1"},
  {q:"faq_q2", a:"faq_a2"},
  {q:"faq_q3", a:"faq_a3"}
];
function renderFAQ(){
  const wrap=document.getElementById("faqList");
  wrap.innerHTML="";
  FAQ_ITEMS.forEach((item,idx)=>{
    const box=document.createElement("div");
    box.className="rounded-2xl bg-[var(--panel)] card-line overflow-hidden";
    box.innerHTML = `
      <button class="faq-toggle w-full flex items-center justify-between p-4 text-left" data-idx="${idx}">
        <span class="text-sm font-medium pr-3">${t(item.q)}</span>
        <svg class="faq-caret shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="accordion-content px-4">
        <p class="text-xs text-[var(--muted)] pb-4">${t(item.a)}</p>
      </div>
    `;
    wrap.appendChild(box);
  });
  wrap.querySelectorAll(".faq-toggle").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      const box=btn.parentElement;
      const content=box.querySelector(".accordion-content");
      const isOpen=box.classList.contains("faq-open");
      wrap.querySelectorAll(".faq-open").forEach(o=>{ o.classList.remove("faq-open"); o.querySelector(".accordion-content").style.maxHeight=null; });
      if(!isOpen){ box.classList.add("faq-open"); content.style.maxHeight = content.scrollHeight+"px"; }
    });
  });
}

/* =====================================================================
   LANGUAGE SWITCHING (persists all state)
   ===================================================================== */
function applyLanguage(lang){
  currentLang = I18N[lang] ? lang : "fr";
  document.documentElement.lang = currentLang;
  document.documentElement.dir = RTL_LANGS.includes(currentLang) ? "rtl" : "ltr";
  document.querySelectorAll("[data-i18n]").forEach(el=>{
    const key = el.dataset.i18n;
    el.textContent = t(key);
  });
  document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{
    el.setAttribute("placeholder", t(el.dataset.i18nPlaceholder));
  });
  // Re-render dynamic content that isn't tagged with data-i18n
  renderAirportCards();
  renderFAQ();
  renderHistory();
  if(document.getElementById("screen-vehicles").classList.contains("active")) renderVehicleScreen();
  if(document.getElementById("screen-payment").classList.contains("active")) updateTripSummary();
  if(document.getElementById("screen-legal").classList.contains("active") && currentLegalDoc){
    document.querySelector(`.btn-legal[data-doc="${currentLegalDoc}"]`).click();
  }
  durationVal.textContent = `${state.duration} ${t("duration_label_h")}`;
}
document.getElementById("langSelect").addEventListener("change", (e)=>applyLanguage(e.target.value));

/* =====================================================================
   INSTALL PWA (simulation)
   ===================================================================== */
const installBtn=document.getElementById("installBtn"), installToast=document.getElementById("installToast");
if(/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)){
  installBtn.classList.remove("hidden");
  installBtn.classList.add("flex");
}
installBtn.addEventListener("click", ()=>{
  installBtn.classList.add("hidden");
  installToast.classList.remove("hidden");
  setTimeout(()=>installToast.classList.add("hidden"), 3000);
});

/* =====================================================================
   COOKIE BANNER — RGPD granulaire (essentiel / statistiques / marketing)
   Note: consentement conservé en mémoire pour la session uniquement.
   En production, ce choix doit être stocké (cookie technique dédié)
   et respecté par tout script tiers (analytics, pixels marketing…).
   ===================================================================== */
const cookieBanner=document.getElementById("cookieBanner");
const cookieDetails=document.getElementById("cookieDetails");
const toggleAnalytics=document.getElementById("toggleAnalytics");
const toggleMarketing=document.getElementById("toggleMarketing");
setTimeout(()=>{ if(!consent.decided) cookieBanner.classList.remove("hidden"); }, 1200);

document.getElementById("cookieCustomize").addEventListener("click", ()=>{
  cookieDetails.classList.toggle("hidden");
});
toggleAnalytics.addEventListener("click", ()=>{
  consent.analytics=!consent.analytics;
  toggleAnalytics.classList.toggle("on", consent.analytics);
  toggleAnalytics.setAttribute("aria-checked", String(consent.analytics));
});
toggleMarketing.addEventListener("click", ()=>{
  consent.marketing=!consent.marketing;
  toggleMarketing.classList.toggle("on", consent.marketing);
  toggleMarketing.setAttribute("aria-checked", String(consent.marketing));
});
function closeCookieBanner(){
  consent.decided=true;
  cookieBanner.classList.add("hidden");
  trackEvent("consent_update", {analytics:consent.analytics, marketing:consent.marketing});
}
document.getElementById("cookieAccept").addEventListener("click", ()=>{
  consent.analytics=true; consent.marketing=true;
  toggleAnalytics.classList.add("on"); toggleMarketing.classList.add("on");
  closeCookieBanner();
});
document.getElementById("cookieReject").addEventListener("click", ()=>{
  consent.analytics=false; consent.marketing=false;
  toggleAnalytics.classList.remove("on"); toggleMarketing.classList.remove("on");
  closeCookieBanner();
});
document.getElementById("cookieSave").addEventListener("click", closeCookieBanner);

/* =====================================================================
   INIT
   ===================================================================== */
renderFAQ();
renderHistory();
(function initLanguage(){
  const browserLang = (navigator.language || "fr").slice(0,2).toLowerCase();
  const initialLang = I18N[browserLang] ? browserLang : "fr";
  document.getElementById("langSelect").value = initialLang;
  applyLanguage(initialLang);
})();
</script>
</body>
</html>
