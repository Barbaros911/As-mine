function normalizeStr(s){
  return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").trim();
}
function findCityMatches(query){
  const q = normalizeStr(query);
  if(!q) return [];
  // Priority 1: city name starts with what the user typed (best UX for progressive typing)
  let matches = CITIES.filter(c=>normalizeStr(c.name).startsWith(q));
  if(matches.length) return matches;
  // Priority 2: the query contains a full city name (e.g. "12 rue de la paix argenteuil")
  matches = CITIES.filter(c=>q.includes(normalizeStr(c.name)));
  if(matches.length) return matches;
  // Priority 3: the city name contains the query as a substring (typo-tolerant, partial word)
  matches = CITIES.filter(c=>normalizeStr(c.name).includes(q));
  return matches;
}
function hashStr(s){ let h=0; for(let i=0;i<s.length;i++){ h=(h*31 + s.charCodeAt(i))>>>0; } return h; }
function simulateAddressSuggestions(query){
  const h = hashStr(query);
  const cityMatches = findCityMatches(query);
  const out=[];
  if(cityMatches.length>0){
    // The user is typing a recognizable city (or an address within it): generate real-looking
    // streets specifically inside that city rather than random unrelated suburbs.
    const pool = cityMatches.slice(0,3);
    const primary = pool[0];
    out.push({ label: `${primary.name}, ${primary.cp} ${primary.name}`, lat: primary.lat, lon: primary.lon });
    for(let i=0;i<4;i++){
      const city = pool[i % pool.length];
      const number = 1 + ((h + i*17) % 120);
      const street = STREET_NAMES[(h+i)%STREET_NAMES.length];
      const type = STREET_TYPES[(h+i*3)%STREET_TYPES.length];
      const jitter = ((h+i)%100)/150000;
      out.push({
        label: `${number} ${type} ${street}, ${city.cp} ${city.name}`,
        lat: city.lat + jitter,
        lon: city.lon + jitter
      });
    }
    return out;
  }
  // No recognizable city in the query: fall back to a broader, varied sample so the
  // list still feels realistic while the user keeps typing.
  for(let i=0;i<5;i++){
    const number = 1 + ((h + i*17) % 120);
    const street = STREET_NAMES[(h+i)%STREET_NAMES.length];
    const type = STREET_TYPES[(h+i*3)%STREET_TYPES.length];
    const city = CITIES[(h+i*7)%CITIES.length];
    const jitter = ((h+i)%100)/100000;
    out.push({
      label: `${number} ${type} ${street}, ${city.cp} ${city.name}`,
      lat: city.lat + jitter,
      lon: city.lon + jitter
    });
  }
  return out;
}
const addressCache = new Map(); // simple client-side cache to reduce API calls / basic rate-limiting
async function fetchAddressSuggestions(query){
  if(!query || query.trim().length<3) return [];
  const cacheKey = query.trim().toLowerCase();
  if(addressCache.has(cacheKey)){
    console.log(`[as-mine] "${query}" → résultat en cache (${addressCache.get(cacheKey).length} adresses)`);
    return addressCache.get(cacheKey);
  }
  const apiUrl = `https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(query)}&limit=8&autocomplete=1`;
  try{
    const controller = new AbortController();
    const timeout = setTimeout(()=>controller.abort(), 6000);
    console.log(`[as-mine] Requête BAN (annuaire national des adresses) →`, apiUrl);
    const res = await fetch(apiUrl, {signal:controller.signal});
    clearTimeout(timeout);
    if(!res.ok) throw new Error(`Réponse HTTP ${res.status}`);
    const data = await res.json();
    if(data && Array.isArray(data.features) && data.features.length>0){
      const results = data.features.map(f=>({
        label: f.properties.label,
        lat: f.geometry.coordinates[1],
        lon: f.geometry.coordinates[0]
      }));
      console.log(`[as-mine] BAN OK — ${results.length} adresses réelles trouvées pour "${query}"`);
      addressCache.set(cacheKey, results);
      return results;
    }
    console.warn(`[as-mine] BAN a répondu mais sans résultat pour "${query}" — repli local.`);
    const results = simulateAddressSuggestions(query);
    addressCache.set(cacheKey, results);
    return results;
  }catch(err){
    console.warn(`[as-mine] Échec de l'appel à l'annuaire national (${err.name}: ${err.message}). Repli sur la base locale — vérifiez la console réseau (onglet Network) si ce message persiste : cela indique généralement un blocage réseau/CORS de l'environnement d'aperçu, pas un bug du code.`);
    const results = simulateAddressSuggestions(query);
    addressCache.set(cacheKey, results);
    return results;
  }
}

/* Real driving distance via OSRM public API, with haversine fallback if unreachable */
async function fetchRouteDistanceKm(pickup, dropoff){
  try{
    const controller = new AbortController();
    const timeout = setTimeout(()=>controller.abort(), 4000);
    const url = `https://router.project-osrm.org/route/v1/driving/${pickup.lon},${pickup.lat};${dropoff.lon},${dropoff.lat}?overview=false`;
    const res = await fetch(url, {signal:controller.signal});
    clearTimeout(timeout);
    if(!res.ok) throw new Error("route unavailable");
    const data = await res.json();
    if(data && data.routes && data.routes[0]){
      return { km: data.routes[0].distance/1000, min: Math.round(data.routes[0].duration/60), estimated:false };
    }
    throw new Error("no route");
  }catch(err){
    // Fallback: straight-line distance with a realistic road-network correction factor
    const km = haversineKm(pickup.lat,pickup.lon,dropoff.lat,dropoff.lon) * 1.3;
    return { km, min: Math.round(km/0.55), estimated:true };
  }
}
function renderSuggestList(listEl, items, onSelect, inputEl){
  listEl.innerHTML="";
  if(items.length===0){
    listEl.innerHTML = `<div class="suggest-item text-[var(--muted)]" role="status">${t("no_results")}</div>`;
  }else{
    items.forEach(item=>{
      const div = document.createElement("div");
      div.className = "suggest-item";
      div.setAttribute("role","option");
      div.setAttribute("tabindex","0");
      div.textContent = item.label;
      const pick=()=>onSelect(item);
      div.addEventListener("click", pick);
      div.addEventListener("keydown",(e)=>{ if(e.key==="Enter" || e.key===" "){ e.preventDefault(); pick(); } });
      listEl.appendChild(div);
    });
  }
  listEl.classList.remove("hidden");
  if(inputEl) inputEl.setAttribute("aria-expanded","true");
}
function attachAutocomplete(inputEl, listEl, onSelected){
  const run = debounce(async ()=>{
    const q = inputEl.value;
    if(q.trim().length<3){ listEl.classList.add("hidden"); inputEl.setAttribute("aria-expanded","false"); return; }
    const items = await fetchAddressSuggestions(q);
    renderSuggestList(listEl, items, (item)=>{
      inputEl.value = item.label;
      listEl.classList.add("hidden");
      inputEl.setAttribute("aria-expanded","false");
      onSelected(item);
    }, inputEl);
  }, 300);
  inputEl.addEventListener("input", run);
  inputEl.addEventListener("focus", ()=>{ if(inputEl.value.trim().length>=3) run(); });
  document.addEventListener("click",(e)=>{
    if(!inputEl.contains(e.target) && !listEl.contains(e.target)){ listEl.classList.add("hidden"); inputEl.setAttribute("aria-expanded","false"); }
  });
}

