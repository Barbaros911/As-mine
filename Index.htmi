function showScreen(id){
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  document.querySelectorAll(".nav-item").forEach(n=>n.classList.toggle("active", n.dataset.target===id));
  window.scrollTo({top:0, behavior:"instant"});
}
document.querySelectorAll(".nav-item, .btn-back, #promoAirports").forEach(el=>{
  el.addEventListener("click", ()=>{
    const target = el.dataset.target || "screen-airports";
    showScreen(target);
  });
});

