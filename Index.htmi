    <div id="legalDocBody" class="text-sm text-[var(--muted)] leading-relaxed space-y-3 whitespace-pre-line"></div>
  </section>

  <!-- ===================== SCREEN: HISTORY (session only) ===================== -->
  <section id="screen-history" class="screen">
