      </button>
      <button class="btn-legal flex items-center justify-between w-full text-sm" data-doc="mentions">
        <span data-i18n="legal_mentions">Mentions légales</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flip-x"><path d="M9 6l6 6-6 6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="btn-legal flex items-center justify-between w-full text-sm" data-doc="privacy">
        <span data-i18n="legal_privacy">Politique de confidentialité</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flip-x"><path d="M9 6l6 6-6 6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </section>

  <!-- ===================== SCREEN: LEGAL DOC ===================== -->
  <section id="screen-legal" class="screen">
    <button class="btn-back flex items-center gap-1.5 text-xs text-[var(--muted)] mb-4" data-target="screen-faq">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flip-x"><path d="M15 6l-6 6 6 6" stroke="#9C9A93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-i18n="back">Retour</span>
