    </div>

    <div class="flex items-center gap-2">
      <button id="cookieCustomize" class="text-[11px] px-3 py-2 rounded-full border border-[var(--line)] text-[var(--muted)] flex-1" data-i18n="cookie_customize">Personnaliser</button>
      <button id="cookieReject" class="text-[11px] px-3 py-2 rounded-full border border-[var(--line)] text-[var(--muted)] flex-1" data-i18n="cookie_reject">Refuser</button>
      <button id="cookieAccept" class="gold-btn text-[11px] px-3 py-2 rounded-full flex-1" data-i18n="cookie_accept">Accepter tout</button>
