<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <!-- Une seule adresse, deux langues. Le site choisit celle du visiteur au
       chargement : il n'existe pas d'URL par langue, et en déclarer serait
       promettre à Google des pages qu'on ne sert pas.
       Les quatre autres langues de l'ancien site ont été retirées d'ici en
       même temps que de la page — un « hreflang » vers une langue qui n'est
       plus servie fait retomber la page dans les résultats. -->
  <url>
    <loc>https://elatransfer.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="fr" href="https://elatransfer.com/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://elatransfer.com/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://elatransfer.com/"/>
  </url>
</urlset>
